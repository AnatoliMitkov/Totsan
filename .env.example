# Public frontend configuration for Vercel / local development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SITE_URL=https://totsan.com

# Optional branding
VITE_BRAND_NAME=Totsan
VITE_BRAND_TAGLINE=Reality Beyond Renders
VITE_CONTACT_EMAIL=sales@example.com
VITE_CONTACT_PHONE=+359892703058
VITE_TURNSTILE_SITE_KEY=

# Server-side only. Set this as a Supabase Edge Function secret, never as VITE_*.
TURNSTILE_SECRET_KEY=

# Transactional subscription/inquiry email. Set as Supabase Edge Function
# secrets; never expose these with a VITE_* prefix.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Totsan <no-reply@totsan.com>

# Optional GA4 configuration. Keep disabled until you have a real consent flow or explicit legal basis.
VITE_GTM_ID=GTM-KRRXFW9H
VITE_GA_MEASUREMENT_ID=G-39RQFR7N0G
VITE_GA_REQUIRE_CONSENT=true

# ============================================================================
# 🤖 AI AGENT ACCESS — For Antigravity, Codex GPT, Claude, etc.
# ============================================================================
# DO NOT commit these to git. Add to .env.local or CI/CD secrets only.
#
# These grant full Supabase access (bypass RLS). AI agents use these to:
# - Compare database schema with project code
# - Sync data, fix mismatches, run migrations
# - Manage orders, users, reviews, audit logs
# - Run bulk operations and data transformations
#
# Get these from: Supabase Dashboard → Settings → API → Project API Keys

SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_ID=your-project-ref-here
SUPABASE_API_URL=https://your-project-ref.supabase.co

# Server-side AI enrichment for cached profile/project summaries.
# Set these as Supabase Edge Function secrets, not as Vite public variables.
OPENAI_API_KEY=sk-proj_replace_me
OPENAI_MODEL=gpt-4.1-mini

