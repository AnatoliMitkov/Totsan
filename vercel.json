{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/((?!api/|assets/|Images/|Logos/|Videos/|Music/|logos.json|favicon.ico|robots.txt|sitemap.xml|google97ff590199fce10d.html).*)",
      "destination": "/index.html"
    }
  ]
}